# Shortest path lengths from vertex 1 in an undirected graph (BFS).
# Input: n m, then m edges "u v". Output: distance to every vertex (-1 = unreachable).
read int n, m;
vec<int>[n + 1] adj;               # adjacency lists: n+1 empty vecs
for e in [1..m]: {
    read int u, v;
    adj[u].push(v);
    adj[v].push(u);
}
int[n + 1] dist;
for i in [1..n]: dist[i] = -1;
vec<int> queue = [1];
dist[1] = 0;
int head = 0;
while head < queue.len(): {
    int u = queue[head];
    head++;
    for v in adj[u]: {
        if dist[v] == -1: {
            dist[v] = dist[u] + 1;
            queue.push(v);
        }
    }
}
for i in [1..n]: print(dist[i], " ");
println();
