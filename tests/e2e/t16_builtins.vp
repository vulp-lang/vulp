# 5.16: builtins min / max / abs and sort
println(min(3, 7), " ", max(3, 7), " ", min(5, 2, 8, 1), " ", max(-1, -5));
println(abs(-42), " ", abs(17), " ", abs(-3.25));
i32 a = -5;
u8 b = 200;
println(min(a, 3), " ", max(b, 100), " ", max('a', 'z'));
println(min(1, 2.5), " ", max(2, 1.5));
int INF = 1000000000000000000;
int best = INF;
for x in [5, 3, 8]: best = min(best, x);
println(best);
vec<int> v = [3, 1, 2];
v.sort();
println(v, " ", v.len());
int[] arr = [9, -1, 4];
arr.sort();
println(arr);
string s = "banana";
s.sort();
println(s);
println(int(1e9), " ", abs(i64(-9223372036854775807)));
