# 5.4: if / elif / else, while, C-style for, for-in ranges, break / continue
fn classify(int n) -> string {
    if n < 0: return "negative";
    elif n == 0: return "zero";
    elif n < 10: { return "small"; }
    else: return "large";
}
println(classify(-5), " ", classify(0), " ", classify(7), " ", classify(100));

int i = 0, total = 0;
while i < 10: {
    i += 1;
    if i % 2 == 0: continue;
    if i > 7: break;
    total += i;
}
println("while: ", total);           # 1 + 3 + 5 + 7

for (int k = 0; k < 5; k++): print(k, " ");
println();
for (int k = 10; k > 0; k -= 3): print(k, " ");
println();
int n = 0;
for ( ; ; ) : {                      # infinite loop with break
    n++;
    if n == 4: break;
}
println("for(;;) ran ", n, " times");

for v in [1..5]: print(v, " ");      # inclusive range
println();
for v in [3..1]: print("never");     # empty range
for v in [-2..2]: print(v, " ");
println();
for c in ['a'..'e']: print(c);       # char ranges
println();

# nested loops: break / continue only affect the innermost loop
for a in [1..3]: {
    for b in [1..3]: {
        if b == 2: continue;
        if a == 3: break;
        print(a, b, " ");
    }
}
println();

# the loop variable is a copy: changing it does not change the iteration
for v in [1..3]: { v *= 10; print(v, " "); }
println();

# a range that ends at the type's maximum terminates
int count = 0;
for b in [i8(120)..i8(127)]: count++;
println("count = ", count);
